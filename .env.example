PORT=4040

# --- Evolution API ---
EVOLUTION_URL=http://127.0.0.1:8080
API_KEY=local_test_key_123

# --- JWT secret ---
# Shared with Nojo_back (OTP_SERVICE_SECRET there) so both sides sign and verify
# the same service-to-service tokens.
JWT_SECRET=ReNile_Secure_Key_2026_!@#

# --- WhatsApp channels (sender numbers) ---
# Sending everything from one number is what gets that number banned for hours:
# WhatsApp scores an unofficial session on how bursty and repetitive it looks.
# List every connected Evolution instance here and the service spreads traffic
# over all of them, so each number sends at 1/N the rate and one ban no longer
# takes logins down with it. All of these share EVOLUTION_URL and API_KEY above.
WHATSAPP_CHANNELS=ReNile_service,ReNile_2,ReNile_3,ReNile_4,ReNile_5

# Left over from the single-number setup, and ignored whenever any channel list
# above is set. Harmless to leave — it is the last-resort fallback if the channel
# lists are ever cleared, which keeps the service sending rather than refusing to
# start.
INSTANCE_NAME=ReNile_service

# --- One farmer, one number ---
# Each farmer is assigned a single sender number and keeps it, because receiving
# the same kind of message from several numbers reads as a scam to the farmer and
# as a spam ring to WhatsApp. Assignment goes to the number carrying the fewest
# farmers, so five farmers over three numbers land 2 / 2 / 1. A farmer is moved
# only if their number can't deliver (disconnected, resting, over its cap) — if
# it is merely busy, the message waits for it.
#
# Turning this off spreads load slightly better but lets a farmer hear from
# several numbers. Not recommended.
WHATSAPP_STICKY_SENDER=true

# Where the farmer-to-number map lives. It is written to disk so a restart does
# not silently move every farmer to a different number.
WHATSAPP_ASSIGNMENTS_FILE=./data/channel-assignments.json

# Forget a farmer's number after this long with no messages, so the map doesn't
# grow forever and freed numbers can take on new farmers.
WHATSAPP_ASSIGNMENT_TTL_DAYS=90

# Where senders added through the admin panel are recorded. These are unioned
# with WHATSAPP_CHANNELS at boot, so linking a number from the panel needs no
# edit to this file and no restart. A name in WHATSAPP_CHANNELS always wins, so
# this file never overrides anything you set here.
WHATSAPP_REGISTRY_FILE=./data/channels.json

# Optional: reserve numbers for one kind of traffic. A number in this list serves
# ONLY logins; one in WHATSAPP_ALERT_CHANNELS serves only alerts; one in neither
# list serves both. These FILTER the list above — keep WHATSAPP_CHANNELS set.
#
# Two costs before you turn this on:
#  - A farmer gets login codes from one number and alerts from another, which
#    gives up the one-number-per-farmer guarantee above.
#  - The login number(s) then carry EVERY farmer's logins, so a single reserved
#    login number becomes the busiest number with the most first-time contacts —
#    and the one whose ban stops all logins. If you reserve, reserve at least two.
#
# Leave both unset unless you specifically want that trade.
# WHATSAPP_OTP_CHANNELS=ReNile_service,ReNile_2
# WHATSAPP_ALERT_CHANNELS=ReNile_3,ReNile_4,ReNile_5

# Optional: full control, for numbers on different Evolution servers or with
# different keys. Overrides WHATSAPP_CHANNELS when set.
# WHATSAPP_CHANNELS_JSON=[{"name":"a","url":"http://host:8080","apiKey":"k","purposes":["otp"]}]

# --- Per-number pacing ---
# Quiet time on ONE number between two of its own messages, plus random jitter
# so its traffic isn't metronomic. These are per number, not global: with five
# numbers the service sustains five messages per gap.
WHATSAPP_CHANNEL_MIN_GAP_MS=5000
WHATSAPP_CHANNEL_JITTER_MS=2000

# Messages one number may send per calendar day. 0 = unlimited. Useful while
# warming up a new number, which WhatsApp trusts less than an established one.
WHATSAPP_CHANNEL_DAILY_CAP=0

# Consecutive failures before a number is pulled out of rotation, and how long
# it rests. Hammering a banned number extends the ban.
WHATSAPP_CHANNEL_FAIL_THRESHOLD=3
WHATSAPP_CHANNEL_COOLDOWN_MS=1800000

# How often each number's Evolution connection state is checked, so a logged-out
# number stops receiving traffic without waiting for messages to fail first.
WHATSAPP_CHANNEL_PROBE_MS=60000

# Different numbers tried before one message is given up on.
WHATSAPP_MAX_SEND_ATTEMPTS=3

# How long a caller waits for any number to come free before returning 503.
WHATSAPP_ACQUIRE_TIMEOUT_MS=20000

# Timeout on a single Evolution API call, so a hung gateway can't hang a request.
WHATSAPP_REQUEST_TIMEOUT_MS=15000

# Ceiling on ONE message end to end, across every retry. Without it, three
# attempts against a hung gateway would each burn the full request timeout above
# and a farmer's login would hang for the sum of them.
WHATSAPP_SEND_DEADLINE_MS=30000

# --- Logging ---
LOG_LEVEL=info

# --- Adding sender numbers ---
# Normally: the Nojo admin panel, under WhatsApp Senders. It works from anywhere,
# because the request goes through the backend — this service and Evolution API
# usually sit on a private network and are not reachable directly.
#
# From a shell on this machine, for first-time setup or recovery:
#   node scripts/link-channels.js ReNile_2=201234567890 ReNile_3=201234567891
#   node scripts/link-channels.js --status
#   node scripts/link-channels.js --remove ReNile_2
#   node scripts/link-channels.js --adopt ReNile_3   # already exists in Evolution
#
# Either way a pairing code has to be entered ON THE PHONE that owns the number:
#   WhatsApp > Settings > Linked devices > Link a device
#            > Link with phone number instead > type the code
#
# WhatsApp requires the phone to approve a linked device — nothing server-side can
# skip that, because the phone holds the account's identity keys. But it is once
# per number and you can read the code to whoever holds the SIM over a call. After
# that the session lives in Evolution, survives restarts, and the phone is never
# needed again.
#
# Do NOT request a second code while the phone shows "Logging in...". Issuing one
# restarts the instance, and restarting mid-handshake makes the phone report
# "Couldn't link device" — which looks like a rejected code but is really the
# server pulling the rug.
#
# The only sender that needs no phone at all is an official Cloud API instance
# (integration: "WHATSAPP-BUSINESS"), which authenticates with a Meta token.
